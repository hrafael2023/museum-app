{
  "name": "Museum App",
  "short_name": "Museum",
  "description": "Aponte a câmera para um cartaz ou obra e veja ou ouça o conteúdo.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
